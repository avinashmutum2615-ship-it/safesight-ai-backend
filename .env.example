PORT=3000
TZ=Asia/Kolkata
MONGODB_URI=mongodb://127.0.0.1:27017/safesight?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_DIR=../safesight-website
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ADMIN_NAME=Clinic Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=9000000000
ADMIN_PASSWORD=
# Optional: clinic management works without AI
GOOGLE_API_KEY=

# Optional clinic metadata for npm run seed-clinic
CLINIC_PHONE=
CLINIC_EMAIL=
CLINIC_ADDRESS=
# Set only if deployed behind exactly one trusted reverse proxy
# TRUST_PROXY=1
